uniform_float ray_strength {
    default = 0.60;
    min = 0.0;
    max = 1.0;
    step = 0.01;
    display_name = "Godray strength";
    description = "Strength of the dynamic scene-depth light shafts around the visible sun.";
}

uniform_float ray_length {
    default = 0.85;
    min = 0.10;
    max = 1.0;
    step = 0.02;
    display_name = "Godray length";
    description = "How far the dynamic shafts extend from the sun toward the screen.";
}

uniform_float sun_glow_strength {
    default = 0.65;
    min = 0.0;
    max = 1.5;
    step = 0.01;
    display_name = "Sun glow strength";
    description = "Strength of the broad glow surrounding the visible sun.";
}

uniform_float direct_glare_strength {
    default = 0.48;
    min = 0.0;
    max = 1.5;
    step = 0.01;
    display_name = "Direct sun glare";
    description = "Full-screen glare when looking directly toward the visible sun.";
}

shared {
    vec3 getSunView051Dynamic()
    {
        // Patch-22/Patch-26 device-proven visual sun-disc projection. Using
        // w=0 keeps camera translation out of the direction transform.
        vec3 disc = omw.sunPos.xyz;
        float discLength = length(disc);
        if (omw.sunPos.z <= 0.0 || discLength < 0.0001)
            return vec3(0.5, 0.5, 0.0);

        vec3 discDir = disc / discLength;
        vec4 viewDir = omw.viewMatrix * vec4(discDir, 0.0);
        vec4 clip = omw.projectionMatrix * viewDir;

        float valid = 1.0;
        if (abs(clip.w) < 0.0001 || clip.w <= 0.0)
            valid = 0.0;

        float safeW = max(abs(clip.w), 0.0001);
        vec2 uv = clip.xy / safeW;
        uv = uv * 0.5 + 0.5;
        return vec3(uv, valid);
    }

    float edgeFade051Dynamic(vec2 uv)
    {
        float x = smoothstep(-0.18, 0.03, uv.x) * (1.0 - smoothstep(0.97, 1.18, uv.x));
        float y = smoothstep(-0.18, 0.03, uv.y) * (1.0 - smoothstep(0.97, 1.18, uv.y));
        return x * y;
    }

    float aspectDistance051Dynamic(vec2 uv, vec2 center, float aspect)
    {
        vec2 d = uv - center;
        d.x *= aspect;
        return length(d);
    }
}

fragment main {
    omw_In vec2 omw_TexCoord;

    float dynamicSkyVisibility051(vec2 uv)
    {
        // Patch 29 restores the proven Android Tex_Depth binding. Use the raw
        // scene depth just like the official multi-pass OMWFX Godrays: cleared
        // sky is at 1.0 while current-frame geometry is below it. A narrow
        // smooth band avoids hard Adreno sampling stripes at silhouette edges.
        float depth = omw_GetDepth(clamp(uv, vec2(0.001), vec2(0.999)));
        return smoothstep(0.99970, 0.99999, depth);
    }

    void main()
    {
        vec4 base = omw_GetLastShader(omw_TexCoord);
        vec3 sunView = getSunView051Dynamic();

        if (sunView.z < 0.5 || omw.sunVis <= 0.001)
        {
            omw_FragColor = base;
            return;
        }

        vec2 sunUv = sunView.xy;
        float edgeVisibility = omw.sunVis * edgeFade051Dynamic(sunUv);
        if (edgeVisibility <= 0.001)
        {
            omw_FragColor = base;
            return;
        }

        float aspect = omw.resolution.x / max(omw.resolution.y, 1.0);
        vec2 toSun = sunUv - omw_TexCoord;
        vec2 aspectFromSun = omw_TexCoord - sunUv;
        aspectFromSun.x *= aspect;
        float sunDistance = length(aspectFromSun);

        // Sixteen independent depth samples recreate the dynamic 0.50 shaft
        // mask. As a branch, actor, creature, or flying object moves through a
        // sample line, the weighted average changes continuously and reshapes
        // the corresponding ray instead of toggling a fixed ray texture.
        float shafts = 0.0;
        float decay = 1.0;
        float decaySum = 0.0;
        for (int i = 0; i < 16; i += 1)
        {
            float t = float(i + 1) / 16.0;
            vec2 sampleUv = omw_TexCoord + toSun * (t * ray_length);
            shafts += dynamicSkyVisibility051(sampleUv) * decay;
            decaySum += decay;
            decay *= 0.94;
        }
        shafts /= max(decaySum, 0.0001);

        // Patch 30 keeps the proven Tex_Depth mask and sample count, but gives
        // it a modest S-curve. Bright shaft regions become clearer while the
        // gaps cast by branches and actors remain dark and well defined.
        float shaftContrast = smoothstep(0.08, 0.92, shafts);
        shafts = mix(shafts, shaftContrast, 0.35);

        float rayEnvelope = smoothstep(0.018, 0.12, sunDistance)
            * (1.0 - smoothstep(0.24, 1.22, sunDistance));

        // Match the useful 0.50 behaviour: a centre blocker removes the broad
        // glare, but a small residual ray budget remains so silhouettes can
        // still form crepuscular shafts around trees, rocks, and actors. A
        // wall covering the sampled region still drives the depth mask to 0.
        float cpuVisibility = clamp(omw.sunOcclusion, 0.0, 1.0);
        float shaftOcclusion = 0.28 + cpuVisibility * 0.72;
        float shaftIntensity = shafts * rayEnvelope * edgeVisibility
            * shaftOcclusion * ray_strength * 1.08;

        float innerGlow = 1.0 - smoothstep(0.015, 0.18, sunDistance);
        float broadGlow = 1.0 - smoothstep(0.05, 0.72, sunDistance);

        float centerDistance = aspectDistance051Dynamic(sunUv, vec2(0.5), aspect);
        float directSun = 1.0 - smoothstep(0.035, 0.48, centerDistance);
        directSun *= directSun;

        vec3 sunColor = max(omw.sunColor.rgb, vec3(0.08));
        vec3 warmColor = sunColor * vec3(1.00, 0.90, 0.72);
        float glowVisibility = edgeVisibility * cpuVisibility;

        vec3 light = vec3(0.0);
        light += warmColor * shaftIntensity * 0.78;
        light += sunColor * broadGlow * sun_glow_strength * 0.42 * glowVisibility;
        light += warmColor * innerGlow * sun_glow_strength * 0.34 * glowVisibility;
        // Patch 40: reduce only the full-screen direct-sun glare by exactly
        // 25 percent. Godrays, the local Sun Glow halo and general Bloom keep
        // their device-proven Patch-39 calibration.
        light += sunColor * directSun * direct_glare_strength * 0.60 * glowVisibility;

        base.rgb += light;
        omw_FragColor = base;
    }
}

technique {
    passes = main;
    description = "OpenMW 0.51 Android vivid dynamic scene-depth Godrays with CPU-occluded Sun Glow.";
    author = "OpenMW Android project; official OMWFX-style depth mask on the restored Android Tex_Depth path";
    version = "3.4-051-depthfixed-vivid-softglare";
    flags = Disable_Interiors, Disable_Underwater;
}
