    {"Tribunal.esm": ["0xF481F334", "0x211329EF"]},
    {"Bloodmoon.esm": ["0x43DD2132", "0x9EB62F26"]},
    {"No Flickering.ESP": ["0xE3DFBFC4"]},
    {"Lake Fjalding Anti-Suck.ESP": ["0x069B7D10"]},
    {"chuzei_helm_no_neck.esp": ["0x0AFA7D6D"]},
    {"GITD_Telvanni_Dormers.ESP": ["0x67ABDCC2"]},
    {"Expansion Delay.ESP": ["0xC8424096"]}
